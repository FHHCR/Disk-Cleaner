<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Disk-Cleaner - Windows 磁盘清理工具"
        Width="900" Height="650"
        MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5,5,5,10">
            <TextBlock Text="🗑️" FontSize="24" VerticalAlignment="Center"/>
            <TextBlock Text="Disk-Cleaner" FontSize="22" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <TextBlock Text="Windows 磁盘清理工具" FontSize="14" Foreground="#7F8C8D" VerticalAlignment="Center" Margin="8,3,0,0"/>
        </StackPanel>

        <!-- 磁盘选择 + 类别选择 -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- 磁盘选择区域 -->
            <GroupBox Grid.Column="0" Header="选择磁盘" Padding="5" Margin="0,0,5,0">
                <ListBox x:Name="DiskListBox" Height="120"
                         SelectionMode="Single"
                         BorderBrush="#BDC3C7" BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DriveLetter}" FontWeight="Bold" Width="30"/>
                                <TextBlock Text="{Binding VolumeLabel}" Width="80" Foreground="#7F8C8D"/>
                                <TextBlock Text="{Binding FreeSpaceGB, StringFormat={}{0:N2} GB}" Foreground="#27AE60"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>

            <!-- 类别选择区域 -->
            <GroupBox Grid.Column="1" Header="选择清理类别" Padding="5" Margin="5,0,0,0">
                <StackPanel>
                    <CheckBox x:Name="ChkDownloads" Content="下载文件" Margin="0,2"/>
                    <CheckBox x:Name="ChkPictures" Content="图片" Margin="0,2"/>
                    <CheckBox x:Name="ChkDocuments" Content="文档" Margin="0,2"/>
                    <CheckBox x:Name="ChkVideos" Content="视频" Margin="0,2"/>
                    <CheckBox x:Name="ChkTemp" Content="临时文件" Margin="0,2"/>
                    <CheckBox x:Name="ChkRecycleBin" Content="回收站（⚠️ 不可恢复）" Margin="0,2" Foreground="#C0392B"/>
                    <CheckBox x:Name="ChkThumbnails" Content="缩略图缓存" Margin="0,2"/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="5,0,5,10">
            <Button x:Name="BtnScan" Content="🔍 扫描" Width="100" Height="32" Margin="0,0,8,0"
                    Background="#3498DB" Foreground="White" FontWeight="Bold"
                    BorderThickness="0" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
            <Button x:Name="BtnClean" Content="🗑️ 清理选中文件" Width="130" Height="32" Margin="0,0,8,0"
                    Background="#E74C3C" Foreground="White" FontWeight="Bold"
                    BorderThickness="0" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
            <Button x:Name="BtnRefresh" Content="🔄 刷新" Width="80" Height="32" Margin="0,0,8,0"
                    Background="#95A5A6" Foreground="White"
                    BorderThickness="0" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
            <CheckBox x:Name="ChkSelectAll" Content="全选文件" VerticalAlignment="Center" Margin="15,0,0,0"/>
        </StackPanel>

        <!-- 文件列表 -->
        <GroupBox Grid.Row="3" Header="可清理文件预览" Padding="5">
            <DataGrid x:Name="FileGrid" AutoGenerateColumns="False"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      BorderThickness="0"
                      Background="White"
                      RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="文件名" Binding="{Binding Name}" Width="200"/>
                    <DataGridTextColumn Header="大小 (KB)" Binding="{Binding SizeKB}" Width="80"/>
                    <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*"/>
                    <DataGridTextColumn Header="修改时间" Binding="{Binding LastModified, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="130"/>
                    <DataGridTextColumn Header="类别" Binding="{Binding Category}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="4" Background="#ECF0F1" Margin="0,5,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="就绪" Foreground="#2C3E50"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="StatsText" Text="" Foreground="#7F8C8D"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
